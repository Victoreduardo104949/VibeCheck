# ===================================================
# VibeCheck AI - Exemplo de Variáveis de Ambiente
# ===================================================
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA envie o arquivo .env com chaves reais para o repositório público.

# Google Gemini API Key (obtenha em https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Stripe Secret Key (obtenha em https://dashboard.stripe.com/apikeys)
# Usada pelas funções serverless no Vercel (/api/checkout e /api/verify)
STRIPE_SECRET_KEY=sk_test_sua_chave_secreta_stripe_aqui
